<Window x:Class="BibClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BibClient"
        WindowState="Maximized"
        WindowStyle="None"
        Topmost="True"
        ResizeMode="NoResize"
        Background="#1E1E2E"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Grid>
        <!-- Фоновое изображение -->
        <Image x:Name="BgImage" Stretch="UniformToFill"/>

        <!-- Затемнение (управляется слайдером BackgroundOpacity) -->
        <Rectangle x:Name="DimOverlay" Fill="Black" Opacity="0.5"/>

        <!-- Основной контент — верхний отступ 8px чтобы TopCenter позиция была ближе к краю -->
        <Grid Margin="40,8,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Номер ПК и статус -->
            <StackPanel x:Name="PanelCenter" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TxtPcNumber" FontSize="52" FontWeight="Bold" Foreground="White" TextAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtLocked" Text="Компьютер заблокирован" FontSize="16" Foreground="#AAA" TextAlignment="Center"/>
                <TextBlock x:Name="TxtClockWarning"
                           Visibility="Collapsed"
                           FontSize="13"
                           Foreground="#EF9F27"
                           TextAlignment="Center"
                           Margin="0,10,0,0"
                           FontWeight="Medium"/>
            </StackPanel>

            <!-- Время и дата -->
            <StackPanel x:Name="PanelTime" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <TextBlock x:Name="TxtTime" FontSize="36" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                <TextBlock x:Name="TxtDate" FontSize="14" Foreground="#AAA" TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Панель разблокировки (пароль) -->
            <Border x:Name="PanelPassword" Visibility="Collapsed" Background="#2A2A3E" CornerRadius="10" Padding="20" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Введите пароль администратора" Foreground="White" FontSize="14" TextAlignment="Center" Margin="0,0,0,10"/>
                    <PasswordBox x:Name="PbPassword" FontSize="14" Padding="8" BorderThickness="0" Background="#3D3D6B" Foreground="White" CaretBrush="White" KeyDown="PbPassword_KeyDown"/>
                    <TextBlock x:Name="TxtError" Text="Неверный пароль" Foreground="#E24B4A" FontSize="12" Visibility="Collapsed" Margin="0,6,0,0" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button x:Name="BtnUnlock" Content="Разблокировать" Background="#1D9E75" Foreground="White" Padding="16,8" Margin="0,0,10,0" Click="BtnUnlock_Click"/>
                        <Button x:Name="BtnHidePassword" Content="Отмена" Background="Transparent" BorderBrush="#555" Foreground="#AAA" Padding="16,8" Click="BtnHidePassword_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Индикатор сети — вынесен из контентного Grid чтобы не мешать позиционированию -->
        <Ellipse x:Name="NetDot" Width="10" Height="10" Fill="Red" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
    </Grid>
</Window>