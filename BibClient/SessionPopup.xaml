<Window x:Class="BibClient.SessionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сессия"
        Width="320" Height="160"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#2A2A3E" CornerRadius="10" BorderBrush="#3D3D6B" BorderThickness="2" Padding="20">
        <StackPanel>
            <TextBlock x:Name="TxtSessionType" Foreground="#1D9E75" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtElapsed" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock x:Name="TxtRemaining" Foreground="#AAA" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="TxtPaused" Foreground="#F0B90B" FontSize="14" FontWeight="Bold" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,8,0,0">⏸ ПАУЗА</TextBlock>
        </StackPanel>
    </Border>
</Window>