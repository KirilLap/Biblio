<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- После publish: сначала публикуем зависимые проекты, затем копируем их в папку публикации.
       Вызывается командой: dotnet publish -p:PublishProfile=win-x64
       ВАЖНО: MSBuild сам определяет порядок — PublishDependencies запускается перед CopyDependenciesAfterPublish. -->
  <Target Name="PublishDependencies" BeforeTargets="CopyDependenciesAfterPublish" AfterTargets="Publish">
    <MSBuild Projects="$(ProjectDir)..\BibClientService\BibClientService.csproj"
             Targets="Publish"
             Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true" />
    <MSBuild Projects="$(ProjectDir)..\BibClientGuardian\BibClientGuardian.csproj"
             Targets="Publish"
             Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true" />
    <Message Text="✅ BibClientService и BibClientGuardian опубликованы" Importance="high" />
  </Target>

  <Target Name="CopyDependenciesAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <!-- dotnet publish кладёт файлы в …\win-x64\publish\ (не в \win-x64\ как dotnet build) -->
      <ServiceFiles Include="$(ProjectDir)..\BibClientService\bin\Release\net10.0-windows\win-x64\publish\*.*" />
      <GuardianFiles Include="$(ProjectDir)..\BibClientGuardian\bin\Release\net10.0-windows\win-x64\publish\BibClientGuardian.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(ServiceFiles)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <Copy SourceFiles="@(GuardianFiles)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <Message Text="✅ BibClientService и BibClientGuardian скопированы в $(PublishDir)" Importance="high" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.7" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- deploy.cmd копируется в папку публикации автоматически -->
    <Content Include="deploy.cmd">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
