<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Post-build: копируем BibClientGuardian.exe и все файлы BibClientService в папку вывода.
       BibClientService.exe — нативный лаунчер .NET, ему нужны .dll и runtimeconfig.json рядом. -->
  <Target Name="CopyDependenciesAfterBuild" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)..\BibClientGuardian\bin\$(Configuration)\net10.0-windows\BibClientGuardian.exe"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <ItemGroup>
      <ServiceFiles Include="$(ProjectDir)..\BibClientService\bin\$(Configuration)\net10.0-windows\win-x64\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ServiceFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <Message Text="✅ BibClientGuardian.exe и BibClientService (все файлы) скопированы в $(OutDir)" Importance="high" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.7" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.7" />
  </ItemGroup>

</Project>
