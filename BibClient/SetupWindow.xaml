<Window x:Class="BibClient.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Первоначальная настройка — BibClient"
        Height="420" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E2E">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock Text="Первоначальная настройка"
                       Foreground="White" FontSize="18"
                       FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Заполните данные для подключения к серверу"
                       Foreground="#666688" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Поля -->
        <StackPanel Grid.Row="1">

            <!-- IP сервера -->
            <TextBlock Text="IP адрес сервера (ПК администратора)"
                       Foreground="#AAAACC" FontSize="12"
                       Margin="0,0,0,6"/>
            <Border BorderBrush="#3D3D6B" BorderThickness="1"
                    CornerRadius="8" Margin="0,0,0,4">
                <TextBox x:Name="TxtServerIp"
                         Background="#2A2A3E" Foreground="White"
                         BorderThickness="0" FontSize="14"
                         Padding="12,10" CaretBrush="White"
                         Text="192.168.1.100"/>
            </Border>
            <TextBlock Text="Пример: 192.168.1.100"
                       Foreground="#444466" FontSize="11"
                       Margin="0,0,0,20"/>

            <!-- Порт -->
            <TextBlock Text="Порт сервера"
                       Foreground="#AAAACC" FontSize="12"
                       Margin="0,0,0,6"/>
            <Border BorderBrush="#3D3D6B" BorderThickness="1"
                    CornerRadius="8" Margin="0,0,0,4">
                <TextBox x:Name="TxtServerPort"
                         Background="#2A2A3E" Foreground="White"
                         BorderThickness="0" FontSize="14"
                         Padding="12,10" CaretBrush="White"
                         Text="8080"/>
            </Border>
            <TextBlock Text="По умолчанию: 8080"
                       Foreground="#444466" FontSize="11"
                       Margin="0,0,0,20"/>

            <!-- Номер ПК -->
            <TextBlock Text="Номер этого компьютера"
                       Foreground="#AAAACC" FontSize="12"
                       Margin="0,0,0,6"/>
            <Border BorderBrush="#3D3D6B" BorderThickness="1"
                    CornerRadius="8" Margin="0,0,0,4">
                <TextBox x:Name="TxtPcNumber"
                         Background="#2A2A3E" Foreground="White"
                         BorderThickness="0" FontSize="14"
                         Padding="12,10" CaretBrush="White"
                         Text="ПК 1"/>
            </Border>

            <!-- IP этого ПК — определяется автоматически -->
            <Border Background="#2A2A3E" CornerRadius="8"
                    Padding="12,10" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="IP этого ПК: "
                               Foreground="#666688" FontSize="12"/>
                    <TextBlock x:Name="TxtLocalIp"
                               Foreground="#1D9E75" FontSize="12"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Ошибка -->
            <TextBlock x:Name="TxtError"
                       Foreground="#E24B4A" FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Кнопка -->
        <Button Grid.Row="2" Content="Сохранить и запустить"
                Click="BtnSave_Click"
                Background="#3D3D6B" Foreground="White"
                FontSize="14" Padding="0,14"
                BorderThickness="0" Cursor="Hand"
                Margin="0,24,0,0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Window>