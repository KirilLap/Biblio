<Page x:Class="BibAdmin.FinancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F5">

    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="bd" Property="Background" Value="#F0FFF8"/>
                                <Setter Property="Foreground" Value="#0F6E56"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Финансы" FontSize="22"
                           FontWeight="Bold" Foreground="#1E1E2E"/>
                <TextBlock x:Name="TxtCurrentDate"
                           Foreground="#888" FontSize="12"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📊 Экспорт в Excel"
                        Click="ExportToCsv_Click"
                        Padding="14,8" FontSize="13" Cursor="Hand"
                        BorderThickness="1" BorderBrush="#1D9E75"
                        Background="#1D9E75" Foreground="White"
                        Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="🗑  Очистить историю"
                        Click="ClearHistory_Click"
                        Padding="14,8" FontSize="13" Cursor="Hand"
                        BorderThickness="1" BorderBrush="#DDDDDD"
                        Background="White" Foreground="#888">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Переключатель вкладок -->
        <Border Grid.Row="1" Background="White" CornerRadius="10"
                Padding="6" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnTabSessions"
                        Content="📋  Сессии"
                        Style="{StaticResource TabBtn}"
                        Tag="active"
                        Click="TabSessions_Click"/>
                <Button x:Name="BtnTabServices"
                        Content="🛎  Услуги"
                        Style="{StaticResource TabBtn}"
                        Click="TabServices_Click"/>
                <Button x:Name="BtnTabAll"
                        Content="📊  Всё"
                        Style="{StaticResource TabBtn}"
                        Click="TabAll_Click"/>
            </StackPanel>
        </Border>

        <!-- Статистика -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White"
                    CornerRadius="10" Margin="0,0,6,0" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="TblTodayLabel" Text="Выручка сегодня"
                               Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtToday" Text="0 сум"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#0F6E56" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White"
                    CornerRadius="10" Margin="3,0,3,0" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="TblWeekLabel" Text="За неделю"
                               Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtWeek" Text="0 сум"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#185FA5" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White"
                    CornerRadius="10" Margin="3,0,3,0" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="TblMonthLabel" Text="За месяц"
                               Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtMonth" Text="0 сум"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#854F0B" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="White"
                    CornerRadius="10" Margin="6,0,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="TblCountLabel" Text="Всего сессий"
                               Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalSessions" Text="0"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#1E1E2E" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Фильтр -->
        <Border Grid.Row="3" Background="White" CornerRadius="10"
                Padding="16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Фильтр:"
                           Foreground="#888" FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <RadioButton x:Name="RbAll" Content="Все"
                             IsChecked="True" Margin="0,0,12,0"
                             FontSize="13" VerticalAlignment="Center"
                             Checked="Filter_Changed"/>
                <RadioButton x:Name="RbToday" Content="Сегодня"
                             Margin="0,0,12,0" FontSize="13"
                             VerticalAlignment="Center"
                             Checked="Filter_Changed"/>
                <RadioButton x:Name="RbWeek" Content="Неделя"
                             Margin="0,0,12,0" FontSize="13"
                             VerticalAlignment="Center"
                             Checked="Filter_Changed"/>
                <RadioButton x:Name="RbMonth" Content="Месяц"
                             Margin="0,0,24,0" FontSize="13"
                             VerticalAlignment="Center"
                             Checked="Filter_Changed"/>

                <!-- Фильтр по типу сессии (только для вкладки Сессии) -->
                <StackPanel x:Name="PnlSessionTypeFilter"
                            Orientation="Horizontal">
                    <TextBlock Text="Тип:"
                               Foreground="#888" FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ComboBox x:Name="CmbType" Width="140"
                              FontSize="13" Padding="8,4"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Все типы" IsSelected="True"/>
                        <ComboBoxItem Content="VIP"/>
                        <ComboBoxItem Content="Лимит"/>
                    </ComboBox>
                </StackPanel>

                <!-- Фильтр по статусу оплаты (только для вкладки Услуги) -->
                <StackPanel x:Name="PnlServiceStatusFilter"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <TextBlock Text="Статус:"
                               Foreground="#888" FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ComboBox x:Name="CmbServiceStatus" Width="140"
                              FontSize="13" Padding="8,4"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                        <ComboBoxItem Content="Оплачено"/>
                        <ComboBoxItem Content="Не оплачено"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="TxtFilterResult"
                           Foreground="#888" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="4" Background="White" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок: Сессии -->
                <Border x:Name="HeaderSessions"
                        Grid.Row="0" Background="#F8F8F8"
                        CornerRadius="10,10,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Компьютер"   Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="1" Text="Тип"          Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="2" Text="ID читателя"  Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="3" Text="Пользователь" Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="4" Text="Длительность" Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="5" Text="Сумма"        Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="6" Text="Дата и время" Foreground="#888" FontSize="12" FontWeight="Medium"/>
                    </Grid>
                </Border>

                <!-- Заголовок: Услуги -->
                <Border x:Name="HeaderServices"
                        Grid.Row="0" Background="#F8F8F8"
                        CornerRadius="10,10,0,0" Padding="16,10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Услуга"       Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="1" Text="Количество"   Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="2" Text="Сумма"        Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="3" Text="Читатель"     Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="4" Text="Статус"       Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="5" Text="Дата и время" Foreground="#888" FontSize="12" FontWeight="Medium"/>
                    </Grid>
                </Border>

                <!-- Заголовок: Всё -->
                <Border x:Name="HeaderAll"
                        Grid.Row="0" Background="#F8F8F8"
                        CornerRadius="10,10,0,0" Padding="16,10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Категория"   Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="1" Text="Описание"    Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="2" Text="Читатель"    Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="3" Text="Сумма"       Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="4" Text="Статус"      Foreground="#888" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="5" Text="Дата"        Foreground="#888" FontSize="12" FontWeight="Medium"/>
                    </Grid>
                </Border>

                <!-- Содержимое -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="SessionsList"/>
                        <StackPanel x:Name="DeletedPcsList"/>
                        <StackPanel x:Name="ServicesList" Visibility="Collapsed"/>
                        <StackPanel x:Name="AllList" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
