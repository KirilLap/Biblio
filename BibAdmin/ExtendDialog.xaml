<Window x:Class="BibAdmin.ExtendDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Продление сессии"
        Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Продление сессии"
                       Foreground="White" FontSize="20"
                       FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtPcInfo"
                       Foreground="#666688" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Поля -->
        <StackPanel Grid.Row="1">

            <!-- Время -->
            <TextBlock Text="Добавить время (минуты)"
                       Foreground="#AAAACC" FontSize="12"
                       Margin="0,0,0,6"/>
            <Border BorderBrush="#3D3D6B" BorderThickness="1"
                    CornerRadius="8" Margin="0,0,0,12">
                <TextBox x:Name="TxtMinutes"
                         Background="#2A2A3E" Foreground="White"
                         BorderThickness="0" FontSize="14"
                         Padding="12,10" CaretBrush="White"
                         TextChanged="TxtMinutes_TextChanged"/>
            </Border>

            <!-- Сумма -->
            <TextBlock Text="Или добавить сумму (сум)"
                       Foreground="#AAAACC" FontSize="12"
                       Margin="0,0,0,6"/>
            <Border BorderBrush="#3D3D6B" BorderThickness="1"
                    CornerRadius="8" Margin="0,0,0,8">
                <TextBox x:Name="TxtMoney"
                         Background="#2A2A3E" Foreground="White"
                         BorderThickness="0" FontSize="14"
                         Padding="12,10" CaretBrush="White"
                         TextChanged="TxtMoney_TextChanged"/>
            </Border>

            <!-- Подсказка -->
            <TextBlock x:Name="TxtHint"
                       Foreground="#1D9E75" FontSize="11"
                       HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Click="BtnCancel_Click"
                    Background="Transparent" Foreground="#666688"
                    FontSize="13" Padding="20,10"
                    BorderThickness="1" BorderBrush="#3D3D6B"
                    Cursor="Hand" Margin="0,0,12,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="Продлить" Click="BtnExtend_Click"
                    Background="#3D3D6B" Foreground="White"
                    FontSize="13" Padding="24,10"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>