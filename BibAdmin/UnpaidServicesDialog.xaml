<Window x:Class="BibAdmin.UnpaidServicesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Неоплаченные услуги"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <StackPanel>
        <!-- Заголовок -->
        <Border Background="#854F0B" Padding="20,14">
            <StackPanel>
                <TextBlock Text="⚠  Есть неоплаченные услуги"
                           Foreground="White" FontSize="15"
                           FontWeight="Bold"/>
                <TextBlock x:Name="TxtReaderInfo"
                           Foreground="#FFD88A" FontSize="11"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Список услуг -->
        <StackPanel x:Name="ServicesList" Margin="20,14,20,0"/>

        <!-- Итого -->
        <Border Background="White" CornerRadius="8" Margin="20,10,20,0"
                Padding="14,10" BorderBrush="#E8E8E8" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Итого к оплате:" FontSize="13"
                           Foreground="#555" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtDebtTotal"
                           Grid.Column="1"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#854F0B"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <Border Background="White" Margin="0,14,0,0" Padding="20,12"
                BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Закрыть (оплатить позже)"
                        Padding="14,8" FontSize="12" Cursor="Hand"
                        BorderThickness="1" BorderBrush="#DDDDDD"
                        Background="White" Foreground="#888"
                        HorizontalAlignment="Left"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnPayAll"
                        Grid.Column="1"
                        Content="✓  Оплатить всё"
                        Padding="16,8" FontSize="13" Cursor="Hand"
                        BorderThickness="1" BorderBrush="#0F6E56"
                        Background="#0F6E56" Foreground="White"
                        Click="PayAll_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </StackPanel>
</Window>
