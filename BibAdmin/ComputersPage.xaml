<Page x:Class="BibAdmin.ComputersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F5">

    <Page.Resources>
        <Style x:Key="PcCard" TargetType="Button">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="105"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Компьютеры" FontSize="22" FontWeight="Bold"
                       Foreground="#1E1E2E" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Заблокировать все"
                        Style="{StaticResource ActionBtn}"
                        Background="#FFF0F0" BorderBrush="#E24B4A"
                        Foreground="#A32D2D"
                        Click="LockAll_Click"/>
                <Button Content="Разблокировать все"
                        Style="{StaticResource ActionBtn}"
                        Background="#F0FFF8" BorderBrush="#1D9E75"
                        Foreground="#0F6E56" Margin="0"
                        Click="UnlockAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- Статистика -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    Margin="0,0,6,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Всего ПК" Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtTotal" Text="0" FontSize="22"
                               FontWeight="Bold" Foreground="#1E1E2E"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="10"
                    Margin="3,0,3,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Онлайн" Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtOnline" Text="0" FontSize="22"
                               FontWeight="Bold" Foreground="#0F6E56"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10"
                    Margin="3,0,3,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Активных сессий" Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtSessions" Text="0" FontSize="22"
                               FontWeight="Bold" Foreground="#185FA5"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="White" CornerRadius="10"
                    Margin="3,0,3,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Заблокировано" Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtLocked" Text="0" FontSize="22"
                               FontWeight="Bold" Foreground="#A32D2D"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="White" CornerRadius="10"
                    Margin="6,0,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Выручка сегодня" Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtRevenue" Text="0 сум" FontSize="18"
                               FontWeight="Bold" Foreground="#1E1E2E"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Сетка ПК -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="PcPanel" Margin="0,0,0,16"/>
        </ScrollViewer>

        <!-- ✅ УПРОЩЕННАЯ Панель управления -->
        <Border Grid.Row="3" Background="White" CornerRadius="10"
                Padding="20,14" Margin="0,8,0,0" MinHeight="56">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHint"
                               Text="Выберите компьютер из списка"
                               Foreground="#AAA" FontSize="13"/>
                    <StackPanel x:Name="PanelInfo"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <!-- ✅ Оставили только название и статус (время и сумма уже в карточке) -->
                        <TextBlock x:Name="TxtPcName" FontSize="15"
                                   FontWeight="Bold" Foreground="#1E1E2E"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtPcStatus" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- ✅ Кнопки без "Заблокировать" -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            x:Name="PanelButtons" Visibility="Collapsed"
                            VerticalAlignment="Center">

                    <Button x:Name="BtnFreeAccess"
                            Content="Свободный доступ"
                            Style="{StaticResource ActionBtn}"
                            Background="#EEF3FF" BorderBrush="#378ADD"
                            Foreground="#185FA5"
                            Click="FreeAccess_Click"/>

                    <Button x:Name="BtnPaidSession"
                            Content="Платная сессия"
                            Style="{StaticResource ActionBtn}"
                            Background="#F0FFF8" BorderBrush="#1D9E75"
                            Foreground="#0F6E56"
                            Click="PaidSession_Click"/>

                    <Button x:Name="BtnPauseSession"
                            Content="⏸ Пауза"
                            Style="{StaticResource ActionBtn}"
                            Background="#FFF8E0" BorderBrush="#F0B90B"
                            Foreground="#856007"
                            Visibility="Collapsed"
                            Click="PauseSession_Click"/>
                    
                    <Button x:Name="BtnExtend"
                            Content="Продлить"
                            Style="{StaticResource ActionBtn}"
                            Background="#FFFBF0" BorderBrush="#EF9F27"
                            Foreground="#854F0B"
                            Visibility="Collapsed"
                            Click="Extend_Click"/>

                    <Button x:Name="BtnEndSession"
                            Content="Завершить сессию"
                            Style="{StaticResource ActionBtn}"
                            Background="#FFF0F0" BorderBrush="#E24B4A"
                            Foreground="#A32D2D"
                            Visibility="Collapsed"
                            Click="EndSession_Click"/>

                    <Button x:Name="BtnForceBlock"
                            Content="Заблокировать"
                            Style="{StaticResource ActionBtn}"
                            Background="#F5F5F5" BorderBrush="#BBBBBB"
                            Foreground="#555" Margin="0"
                            Visibility="Collapsed"
                            Click="ForceBlock_Click"/>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>