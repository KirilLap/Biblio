<Window x:Class="BibAdmin.ScreenViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр экрана" Height="600" Width="900"
        Background="#0D0D1A" WindowStartupLocation="CenterOwner"
        Closed="Window_Closed">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleLabel" Grid.Row="0"
                   Foreground="#E0E0F0" FontSize="15" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1" Background="#000" CornerRadius="6">
            <Image x:Name="ScreenImage" Stretch="Uniform"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="StatusLabel" Foreground="#777" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Закрыть" Click="Close_Click"
                    Background="#1d9e75" Foreground="White" BorderThickness="0"
                    Padding="14,6" FontSize="13" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
