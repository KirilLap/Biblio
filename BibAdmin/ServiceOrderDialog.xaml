<Window x:Class="BibAdmin.ServiceOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дополнительная услуга"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DlgBtn" TargetType="Button">
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Заголовок -->
        <Border Background="#1E1E2E" Padding="20,16">
            <StackPanel>
                <TextBlock Text="🛎  Оказать услугу"
                           Foreground="White" FontSize="16"
                           FontWeight="Bold"/>
                <TextBlock Text="Создать транзакцию дополнительной услуги"
                           Foreground="#666688" FontSize="11"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Содержимое -->
        <StackPanel Margin="20,16">

            <!-- Услуга + количество -->
            <TextBlock Text="Услуга" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CmbService"
                          FontSize="13" Padding="8,6"
                          SelectionChanged="CmbService_Changed"/>
                <TextBlock Grid.Column="1"
                           Text="×"
                           FontSize="16" Foreground="#888"
                           VerticalAlignment="Center"
                           Margin="10,0"/>
                <TextBox x:Name="TxtQty"
                         Grid.Column="2"
                         Style="{StaticResource Field}"
                         Text="1"
                         TextAlignment="Center"
                         TextChanged="TxtQty_Changed"/>
            </Grid>

            <!-- Итого -->
            <Border Background="White" CornerRadius="8"
                    Padding="14,10" Margin="0,0,0,16"
                    BorderBrush="#E8E8E8" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TxtServiceInfo"
                                   Text="—"
                                   Foreground="#888" FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTotal"
                               Grid.Column="1"
                               Text="0 сум"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#0F6E56"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Читатель (необязательно) -->
            <TextBlock Text="Читатель (необязательно)"
                       Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="Введите имя, фамилию или номер читательского билета"
                       FontSize="11" Foreground="#AAA"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="TxtReader"
                     Style="{StaticResource Field}"
                     Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtActiveSession"
                       FontSize="11" Foreground="#1D9E75"
                       Visibility="Collapsed"
                       Margin="0,0,0,14"/>

            <!-- Оплата -->
            <TextBlock Text="Оплата" Style="{StaticResource FieldLabel}"/>
            <Border Background="White" CornerRadius="8"
                    Padding="14,12" Margin="0,0,0,4"
                    BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel>
                    <RadioButton x:Name="RbPaidNow"
                                 Content="Оплачено сейчас"
                                 FontSize="13" IsChecked="True"
                                 Margin="0,0,0,10"/>
                    <RadioButton x:Name="RbDeferred"
                                 Content="Отложить (читатель оплатит позже)"
                                 FontSize="13"/>
                    <TextBlock x:Name="TxtDeferNote"
                               Text="ⓘ Без привязки к читателю нельзя отложить оплату"
                               FontSize="11" Foreground="#E09000"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Кнопки -->
        <Border Background="White" Padding="20,14"
                BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource DlgBtn}"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        Foreground="#888"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button x:Name="BtnCreate"
                        Content="Создать заказ"
                        Style="{StaticResource DlgBtn}"
                        Background="#1D9E75"
                        BorderBrush="#1D9E75"
                        Foreground="White"
                        Click="Create_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
